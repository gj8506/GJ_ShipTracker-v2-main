rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Reads the caller's role and normalises legacy values ("Admin", "STAFF ",
    // etc.) so accounts created before the role names were standardised keep
    // working. Without this the Staff Approvals list is denied to an owner
    // whose profile stores "Admin" instead of "admin".
    function currentRole() {
      return exists(userPath(request.auth.uid))
        ? get(userPath(request.auth.uid)).data.get('role', 'customer').trim().lower()
        : '';
    }

    function isStaffOrAdmin() {
      return isSignedIn() && currentRole() in ['admin', 'staff'];
    }

    function isAdmin() {
      return isSignedIn() && currentRole() == 'admin';
    }

    function roleOf(data) {
      return data.get('role', 'customer').trim().lower();
    }

    function statusOf(data) {
      return data.get('status', '').trim().lower();
    }

    // ------------------------------------------------------------------
    // Users / staff approvals
    // ------------------------------------------------------------------

    match /users/{userId} {
      // Admins and staff can list every profile (needed by the Staff
      // Approvals screen); everyone can always read their own profile.
      allow read: if isStaffOrAdmin()
                  || (isSignedIn() && request.auth.uid == userId);

      // New accounts: customers are active immediately; staff start pending
      // and must be approved by an admin/owner.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && (
                      (roleOf(request.resource.data) == 'customer'
                        && statusOf(request.resource.data) == 'active')
                      ||
                      (roleOf(request.resource.data) == 'staff'
                        && statusOf(request.resource.data) == 'pending')
                    );

      // Admins can update any profile (approve/reject staff, change roles).
      // Users may update their own non-privileged fields, but can never change
      // their own role or approval status.
      allow update: if isAdmin()
                    || (
                      isSignedIn()
                      && request.auth.uid == userId
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
                    );

      allow delete: if isAdmin();
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Daily staff-application counter used to enforce the 10-per-day cap.
    //
    // The document holds only the date key and an aggregate count, so it is
    // safe to read publicly without exposing any personal data. A signed-in
    // applicant may create the day with count 1 or bump it by exactly one, but
    // can never set it beyond the cap, rewrite the date, or delete history.
    match /staff_registration_days/{dayKey} {
      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.day == dayKey
                    && request.resource.data.count == 1;

      allow update: if isSignedIn()
                    && request.resource.data.day == resource.data.day
                    && request.resource.data.count
                         == resource.data.count + 1
                    && request.resource.data.count <= 10;

      allow delete: if false;
    }

    match /parcels/{parcelId} {
      allow read, write: if isStaffOrAdmin();
    }

    match /returns/{returnId} {
      allow read, write: if isStaffOrAdmin();
    }

    match /analytics/{docId} {
      allow read, write: if isStaffOrAdmin();
    }

    // Data Privacy Act policy. Publicly readable because the consent gate runs
    // before sign-in; only an owner/admin may publish changes.
    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Registry / QR codes.
    //
    // Staff and admins manage every row (Dispatch registry). A customer may
    // read and create only their own deterministic row, `customers/{uid}`, and
    // may edit only the contact fields — never `linkedUid`, `type`, or the
    // QR payload. The `customerId == request.auth.uid` check comes first so a
    // missing document (no `resource.data`) still evaluates safely.
    match /customers/{customerId} {
      allow read: if isStaffOrAdmin()
                  || (isSignedIn() && customerId == request.auth.uid);

      allow create: if isStaffOrAdmin()
                    || (
                      isSignedIn()
                      && customerId == request.auth.uid
                      && request.resource.data.linkedUid == request.auth.uid
                    );

      allow update: if isStaffOrAdmin()
                    || (
                      isSignedIn()
                      && customerId == request.auth.uid
                      && resource.data.linkedUid == request.auth.uid
                      && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['linkedUid', 'type', 'createdAt'])
                    );

      allow delete: if isStaffOrAdmin();
    }

    match /order_requests/{requestId} {
      allow read: if isStaffOrAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isStaffOrAdmin();
    }

    // Customer support chat is owner/admin-only. Staff accounts can run
    // dispatch, returns, and analytics, but they must never read or reply to
    // customer conversations. Customers can only reach their own thread.
    match /support_chats/{chatId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.customerUid == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/support_chats/$(chatId)).data.customerUid == request.auth.uid);
        allow create: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/support_chats/$(chatId)).data.customerUid == request.auth.uid);
      }
    }
  }
}
